PORT=3000
JN_TOKEN=your_jobnimbus_token_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# Apple Maps Server API (apple.js) — PRIMARY provider for /geocode, /places/*,
# JN-sync geocoding, GET /routes/etas (drive times) and GET /maps/snapshot-url.
# All four are required; GET /maps/status reports { apple, google }.
# Key: Apple Developer → Keys → "Maps" (MapKit JS / Maps Server API); the Maps ID
# is the identifier you registered (e.g. maps.app.dryops.server).
# APPLE_MAPS_TEAM_ID=ABCDE12345
# APPLE_MAPS_KEY_ID=XYZ987WVU6
# APPLE_MAPS_ID=maps.app.dryops.server
# APPLE_MAPS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
#                                 # raw .p8 text, one line with literal \n, or base64 of the file
# APPLE_MAPS_SNAPSHOT_SIG=der     # only if Apple rejects snapshot signatures (default: ieee-p1363 r||s)
# Google Maps is now the FALLBACK (geocode / Places) when Apple is unset or
# errors; after it the keyless Census / Nominatim / Photon chain always runs.
# GOOGLE_MAPS_KEY=
# CallRail (call tracking)
CALLRAIL_API_KEY=your_callrail_api_key
CALLRAIL_ACCOUNT_IDS=ACC...one,ACC...two   # comma-separated; one API key can span multiple accounts
CALLRAIL_WEBHOOK_TOKEN=a_long_random_secret_you_choose
# Collections classifier (owner Collections tab; collections.js)
# provider:model — gemini:<model> needs GEMINI_API_KEY; anthropic:<model> needs ANTHROPIC_API_KEY
COLLECTIONS_MODEL=gemini:gemini-3.1-flash-lite
GEMINI_API_KEY=your_google_ai_studio_key
# COLLECTIONS_ENABLED=false       # schedulers off (endpoints still work)
# COLLECTIONS_MAX_LLM_JOBS=6000   # per-run LLM call cap
# COLLECTIONS_MAX_COST_USD=10     # per-run spend cap
# COLLECTIONS_FULL_HOUR=3         # America/Denver hour of the nightly full pass
# COLLECTIONS_INCREMENTAL_HOURS=6
# Monitor note reviewer (Schedule → monitor planner; monitor.js). Same key(s) as above.
# MONITOR_MODEL=gemini:gemini-3.1-flash-lite   # provider:model, defaults like COLLECTIONS_MODEL
# MONITOR_DISABLED=1              # schedulers off (endpoints still work)
# MONITOR_LOOKBACK_DAYS=45        # how far back to read JN notes
# MONITOR_NOTES_PER_JOB=20        # newest human notes sent to the model
# MONITOR_NOTE_CHARS=500          # per-note character clip
# MONITOR_INCREMENTAL_HOURS=2     # incremental pass cadence, 06:00–20:00 America/Denver only
# MONITOR_FULL_HOUR=4             # America/Denver hour of the daily full pass
# MONITOR_MAX_LLM_JOBS=1500       # per-run LLM call cap
# MONITOR_MAX_COST_USD=3          # per-run spend cap
# Twilio SMS (tech ETA texts; GET /admin/sms/status reports readiness)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1303...
# TWILIO_INBOUND_ENABLED=1        # inbound replies wired up (0/unset = no); homeowner "reply 1/2" answers (hoWindows.js)
# TWILIO_WEBHOOK_URL=https://dryops-server-production.up.railway.app/webhooks/twilio/sms
#                                 # the EXACT URL set as the number's "A message comes in" webhook (HTTP POST);
#                                 # used to validate X-Twilio-Signature. Unset + NODE_ENV=production = inbound rejected.
# Homeowner portal + window offers (homeowner.js / hoWindows.js)
# PORTAL_BASE_URL=https://dryops.app   # public page lives at <PORTAL_BASE_URL>/h/<token>
# HO_SMS_DRYRUN=1                 # log homeowner texts (offers, reminders, stage texts) instead of sending
# HO_NOTIFY_DISABLED=1            # no homeowner texts at all (stage / request acknowledgements / quiet-hours sweep)
# HO_REMINDERS_DISABLED=1         # no "pick a time" reminder sweep (every 15 min, after schedule_settings.ho_reminder_minutes)
# Scheduling → JobNimbus tasks (one task per visit; see server.js "visit ↔ JobNimbus TASK sync")
# JN_TASKS_DRYRUN=1              # log task payloads instead of posting
# JN_TASKS_REDIRECT_JOB=<jnid>   # relate every task to one test job
# JN_TASKS_SWEEP=0               # disable the 60 s dirty-row sweep
