PORT=3000
JN_TOKEN=your_jobnimbus_token_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# CallRail (call tracking)
CALLRAIL_API_KEY=your_callrail_api_key
CALLRAIL_ACCOUNT_IDS=ACC...one,ACC...two   # comma-separated; one API key can span multiple accounts
CALLRAIL_WEBHOOK_TOKEN=a_long_random_secret_you_choose
# Collections classifier (owner Collections tab; collections.js)
# provider:model — gemini:<model> needs GEMINI_API_KEY; anthropic:<model> needs ANTHROPIC_API_KEY
COLLECTIONS_MODEL=gemini:gemini-3.1-flash-lite
GEMINI_API_KEY=your_google_ai_studio_key
# COLLECTIONS_ENABLED=false       # schedulers off (endpoints still work)
# COLLECTIONS_MAX_LLM_JOBS=6000   # per-run LLM call cap
# COLLECTIONS_MAX_COST_USD=10     # per-run spend cap
# COLLECTIONS_FULL_HOUR=3         # America/Denver hour of the nightly full pass
# COLLECTIONS_INCREMENTAL_HOURS=6
